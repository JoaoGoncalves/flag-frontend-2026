// S3 · extra · ficha 19 · maior e menor de cinco numeros (sem ordenar)
inicio
    inteiro n, maior, menor

    escrever "Numero 1: "
    ler n
    maior <- n
    menor <- n

    escrever "Numero 2: "
    ler n
    se n > maior entao
        maior <- n
    fimse
    se n < menor entao
        menor <- n
    fimse

    escrever "Numero 3: "
    ler n
    se n > maior entao
        maior <- n
    fimse
    se n < menor entao
        menor <- n
    fimse

    escrever "Numero 4: "
    ler n
    se n > maior entao
        maior <- n
    fimse
    se n < menor entao
        menor <- n
    fimse

    escrever "Numero 5: "
    ler n
    se n > maior entao
        maior <- n
    fimse
    se n < menor entao
        menor <- n
    fimse

    escrever "Maior: ", maior, "  Menor: ", menor
fim
