// S3 · trabalho de casa · ficha 23 · Exmo. Sr. ou Exma. Sra.
inicio
    texto nome
    caracter sexo

    escrever "Nome: "
    ler nome
    escrever "Sexo (m/f): "
    ler sexo

    se sexo = "m" ou sexo = "M" entao
        escrever "Exmo. Sr.\n"
    senao
        escrever "Exma. Sra.\n"
    fimse
    escrever nome
fim
