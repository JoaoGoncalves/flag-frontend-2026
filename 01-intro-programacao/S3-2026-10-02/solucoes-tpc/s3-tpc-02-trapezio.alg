// S3 · trabalho de casa · ficha 2 · area do trapezio
inicio
    real base1, base2, altura, area

    escrever "Base maior: "
    ler base1
    escrever "Base menor: "
    ler base2
    escrever "Altura: "
    ler altura

    area <- (base1 + base2) * altura / 2

    escrever "Area do trapezio: ", area
fim
