// S3 · snippet 3 · precedencia: primeiro no papel e depois a correr
inicio
    escrever "A: ", 2 + 3 * 4, "\n"
    escrever "B: ", (2 + 3) * 4, "\n"
    escrever "C: ", 10 - 4 - 2, "\n"
    escrever "D: ", 20 / 2 * 5, "\n"
    escrever "E: ", 17 % 5 + 1, "\n"
    escrever "F: ", 2 + 3 > 4, "\n"
    escrever "G: ", 5 > 3 e 2 > 4
fim
