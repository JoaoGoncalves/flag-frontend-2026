// S3 · snippet 1 · tipos e constantes
inicio
    inteiro idade <- 34
    real preco <- 14.5
    texto nome <- "Ana"
    caracter escalao <- "B"
    logico aprovado <- verdadeiro
    constante real IVA <- 0.23

    escrever nome, " tem ", idade, " anos\n"
    escrever "Preco com IVA: ", preco + preco * IVA, " euros\n"
    escrever "Escalao ", escalao, " - aprovado? ", aprovado
fim
