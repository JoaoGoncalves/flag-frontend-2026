// S2 · exercicio 2 · area e perimetro de um retangulo
inicio
    inteiro largura, altura, area, perimetro

    escrever "Largura (m): "
    ler largura
    escrever "Altura (m): "
    ler altura

    area <- largura * altura
    perimetro <- 2 * (largura + altura)

    escrever "Area: ", area, " m2\n"
    escrever "Perimetro: ", perimetro, " m"
fim
