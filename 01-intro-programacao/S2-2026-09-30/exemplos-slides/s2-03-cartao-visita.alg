// S2 · exercicio 1 · cartao de visita (sequencia)
inicio
    texto nome, cidade
    inteiro idade

    escrever "Nome: "
    ler nome
    escrever "Idade: "
    ler idade
    escrever "Cidade: "
    ler cidade

    escrever "\n----------------------------\n"
    escrever nome, " - ", idade, " anos - ", cidade
    escrever "\n----------------------------\n"
fim
