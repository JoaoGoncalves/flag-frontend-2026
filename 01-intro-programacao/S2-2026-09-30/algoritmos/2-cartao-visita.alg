inicio
    texto nome, cidade
    inteiro idade
    
    escrever "Nome: "
    ler nome
    
    escrever "Cidade: "
    ler cidade
    
    escrever "Idade: "
    ler idade
    
    escrever "\n --------------------------------\n"
    escrever nome, " - ", idade, " - ", cidade
    escrever "\n --------------------------------\n"
fim
